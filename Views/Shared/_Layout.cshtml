<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profi Dental</title>
    <link rel="stylesheet" href="~/css/general.css">
    <link rel="stylesheet" href="~/css/header.css">
    <link rel="stylesheet" href="~/css/hero.css">
    <link rel="stylesheet" href="~/css/about.css">
    <link rel="stylesheet" href="~/css/why-choose.css">
    <link rel="stylesheet" href="~/css/services.css">
    <link rel="stylesheet" href="~/css/faq.css">
    <link rel="stylesheet" href="~/css/results.css">
    <link rel="stylesheet" href="~/css/contacts.css">
    <link rel="stylesheet" href="~/css/footer.css">
    <link rel="stylesheet" href="~/css/privacy.css">
    <link rel="stylesheet" href="~/css/price.css">

    <script src="~/js/script.js" defer></script>
</head>
<body>

    <header>
        <a class="logo" asp-controller="Home" asp-action="Index"><img class="logo-img" src="images/logo.png"></a>
        <div class="go-to hide-on-mobile">
            <a href="#">
                About the Clinic
            </a>
            <a href="#">
                Services
            </a>
            <a asp-controller="Prices" asp-action="Price">
                Price
            </a>
            <a href="#">
                FAQ
            </a>
            <a href="#">
                Contacts
            </a>
        </div>
        <div class="header-btns hide-on-mobile">
            <button class="book-btn">
                Book an Appointment
            </button>
            <button class="lang-btn">
                EN
            </button>
        </div>
        <button onclick="showSidebar()" class="hamburger-menu-btn">
            <img src="images/svgs/hamburger.svg">
        </button>
    </header>

    <div class="sidebar">
        <button onclick="hideSidebar()" class="close-btn">
            <img src="images/svgs/close.svg">
        </button>
        <div class="sidebar-btns">
            <a href="#">
                About the Clinic
            </a>
            <a href="#">
                Services
            </a>
            <a asp-controller="Prices" asp-action="Price">
                Price
            </a>
            <a href="#">
                FAQ
            </a>
            <a href="#">
                Contacts
            </a>
            <button class="book-btn">
                Book an Appointment
            </button>
            <button class="lang-btn">
                EN
            </button>
        </div>
    </div>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="upper-footer">
            <a asp-controller="Home" asp-action="Index" class="upper-footer__logo">
                <img class="upper-footer__logo-img" src="images/logo.png">
            </a>
            <div class="upper-footer__links">
                <a asp-controller="Home" asp-action="Index">
                    About the Clinic
                </a>
                <a href="#">
                    Services
                </a>
                <a asp-controller="Prices" asp-action="Price">
                    Price
                </a>
                <a href="#">
                    FAQ
                </a>
                <a href="#">
                    Contacts
                </a>
            </div>
            <button class="footer__book-btn">
                Book an Appointment
            </button>
        </div>
        <div class="lower-footer">
            <a asp-controller="Home" asp-action="Privacy">
                Privacy Policy
            </a>
            <p>
                Profi Dental © 2026 Vinnytsia.
                All rights reserved
            </p>
            <p>
                Created by <a href="#">Stanislav</a>
            </p>
        </div>
    </footer>

</body>
</html>
