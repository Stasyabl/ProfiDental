<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profi Dental</title>
    <link rel="stylesheet" href="~/css/general.css">
    <link rel="stylesheet" href="~/css/header.css">
    <link rel="stylesheet" href="~/css/hero.css">
    <link rel="stylesheet" href="~/css/about.css">
    <link rel="stylesheet" href="~/css/why-choose.css">
    <link rel="stylesheet" href="~/css/services.css">
    <link rel="stylesheet" href="~/css/faq.css">
    <link rel="stylesheet" href="~/css/results.css">
    <link rel="stylesheet" href="~/css/contacts.css">
    <link rel="stylesheet" href="~/css/footer.css">

    <script src="~/js/script.js" defer></script>
</head>
<body>

    <header>
        <a class="logo" href="#"><img class="logo-img" src="images/logo.png"></a>
        <div class="go-to hide-on-mobile">
            <a>
                About the Clinic
            </a>
            <a>
                Services
            </a>
            <a>
                Price
            </a>
            <a>
                FAQ
            </a>
            <a>
                Contacts
            </a>
        </div>
        <div class="header-btns hide-on-mobile">
            <button class="book-btn">
                Book an Appointment
            </button>
            <button class="lang-btn">
                EN
            </button>
        </div>
        <button onclick="showSidebar()" class="hamburger-menu-btn">
            <img src="images/svgs/hamburger.svg">
        </button>
    </header>

    <div class="sidebar">
        <button onclick="hideSidebar()" class="close-btn">
            <img src="images/svgs/close.svg">
        </button>
        <div class="sidebar-btns">
            <a>
                About the Clinic
            </a>
            <a>
                Services
            </a>
            <a>
                Price
            </a>
            <a>
                FAQ
            </a>
            <a>
                Contacts
            </a>
            <button class="book-btn">
                Book an Appointment
            </button>
            <button class="lang-btn">
                EN
            </button>
        </div>
    </div>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

</body>
</html>
